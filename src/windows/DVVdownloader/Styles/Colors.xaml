<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ana Renk Paleti -->
    <Color x:Key="ColorBackground">#0A0C14</Color>
    <Color x:Key="ColorSidebar">#0D0F1A</Color>
    <Color x:Key="ColorCardSurface">#1A1D2E</Color>
    <Color x:Key="ColorCardSurfaceHover">#24283F</Color>
    <Color x:Key="ColorCardBorder">#2E3352</Color>
    <Color x:Key="ColorCardBorderFocus">#7B61FF</Color>

    <!-- Vurgu Renkleri -->
    <Color x:Key="ColorPrimaryAccent">#7B61FF</Color>
    <Color x:Key="ColorPrimaryAccentHover">#927AFF</Color>
    <Color x:Key="ColorPrimaryAccentPressed">#6042EA</Color>
    <Color x:Key="ColorPrimaryAccentDark">#3B2A8C</Color>

    <!-- Durum Renkleri -->
    <Color x:Key="ColorSuccess">#22C55E</Color>
    <Color x:Key="ColorError">#EF4444</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>

    <!-- Metin Renkleri -->
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#9DA4BD</Color>
    <Color x:Key="ColorTextMuted">#5A607F</Color>

    <!-- Fırçalar (Brushes) -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushCardSurface" Color="{StaticResource ColorCardSurface}" />
    <SolidColorBrush x:Key="BrushCardSurfaceHover" Color="{StaticResource ColorCardSurfaceHover}" />
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}" />
    <SolidColorBrush x:Key="BrushCardBorderFocus" Color="{StaticResource ColorCardBorderFocus}" />

    <SolidColorBrush x:Key="BrushPrimaryAccent" Color="{StaticResource ColorPrimaryAccent}" />
    <SolidColorBrush x:Key="BrushPrimaryAccentHover" Color="{StaticResource ColorPrimaryAccentHover}" />
    <SolidColorBrush x:Key="BrushPrimaryAccentPressed" Color="{StaticResource ColorPrimaryAccentPressed}" />
    <SolidColorBrush x:Key="BrushPrimaryAccentDark" Color="{StaticResource ColorPrimaryAccentDark}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7B61FF" Offset="0" />
        <GradientStop Color="#5B38EB" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
