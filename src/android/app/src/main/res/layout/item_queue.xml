<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Satır: Başlık, Platform ve Durum Rozeti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Video title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTaskPlatform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="YouTube • 1080p"
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="Downloading"
                android:textColor="@color/primary_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- İlerleme Çubuğu -->
        <ProgressBar
            android:id="@+id/pbTaskProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="45"
            android:progressTint="@color/primary_accent" />

        <!-- Hata Mesajı Alanı -->
        <TextView
            android:id="@+id/tvTaskError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_color"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Alt Satır: İstatistikler ve Aksiyon Butonları (ERR-005 Çakışma Önleyici Grid Düzeni) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTaskPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="45%"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTaskSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text=" • 3.4 MB/s"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryTask"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_retry"
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="6dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelTask"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/error_color"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveTask"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
