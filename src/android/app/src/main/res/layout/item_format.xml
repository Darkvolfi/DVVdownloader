<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFormatQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1080p Full HD"
            android:textColor="@color/primary_accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@color/card_surface_hover"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvFormatExt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MP4 Video"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFormatSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~24 MB"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <RadioButton
            android:id="@+id/rbSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
